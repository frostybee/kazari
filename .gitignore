my-docs/
#demo/
#docs/

showcase.html
demo/nuri/showcase.css
demo/nuri/showcase.js

demo/chroma/showcase.css
demo/chroma/showcase.js

*-output.md

# Hugo drops a lock file into any site it builds, including the test
# fixture sites under process/testdata/hugo-fixture/.
.hugo_build.lock

*.png
!kazari-block.png
# brand/ holds the master brand assets, so raster exports there stay tracked.
!brand/**/*.png
# The social cards plugin rasterizes its logo and watermark from public/, and it
# cannot read SVG. These two copies must survive a fresh clone or the deploy
# build renders every card without a mark.
!docs/public/images/*.png

# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/
.cache/
dist/
